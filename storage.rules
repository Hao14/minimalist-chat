rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /chat_files/{ownerUid}/{roomId}/{fileName} {
      // Chat attachments are shared through their tokenized download URL after
      // the authenticated message endpoint accepts the message. Direct bucket
      // reads and listing stay closed, preventing signed-in users from browsing
      // other rooms' files.
      allow read: if false;

      allow create: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size > 0
        && request.resource.size <= 3221225472
        && request.resource.metadata.ownerUid == ownerUid
        && request.resource.metadata.roomId == roomId
        && request.resource.metadata.messageId is string
        && request.resource.metadata.messageId.size() > 8
        && request.resource.metadata.messageId.size() <= 128;

      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
