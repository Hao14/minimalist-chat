# Firebase Functions runtime settings for the protected Ollama gateway.
# Copy to functions/.env.chat-app-356c1 before deploying production.
#
# OLLAMA_SERVER_URL is the fixed named Cloudflare Tunnel hostname. The tunnel's
# only origin is the protected bridge at http://127.0.0.1:8790. Never point it at
# tray Ollama on 11434, protected Ollama on 11435, or a rotating TryCloudflare URL.
OLLAMA_SERVER_URL=https://ai.minimalist.chat
OLLAMA_FAST_MODEL=qwen3:4b-instruct
OLLAMA_SMART_MODEL=qwen3:14b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
AI_ALLOW_GROQ_FALLBACK=false

# Optional text-AI overflow router. It is off by default so existing deployments
# keep their protected-Ollama behavior until every provider is configured.
# When enabled, active requests fill fixed tiers in this order:
#   1-10 protected Ollama, 11-50 Cloudflare Workers AI, 51-90 Groq.
# Request 91+ receives HTTP 202 and remains in the durable FIFO queue until a
# slot completes. Unfinished routed work is bounded at 10,000 globally / 1,000
# per owner; accepted jobs are never evicted.
AI_MULTI_PROVIDER_ROUTING=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# App Check is off until the web app has a valid FIREBASE_APP_CHECK_SITE_KEY in
# public/config.js and a deployed smoke test confirms App Check tokens are sent.
REQUIRE_APP_CHECK=false

# Optional GitHub issue publishing. The app queues trusted issue drafts without
# this token. When configured, queued drafts can publish to GitHub server-side.
# Prefer Secret Manager where possible; .env values are still server-only and
# never sent to the browser.
# GITHUB_ISSUE_TOKEN=github_pat_or_fine_grained_token
GITHUB_ISSUE_OWNER=Hao14
GITHUB_ISSUE_REPO=minimalist-chat
GITHUB_ISSUE_LABELS=from-app,user-report
GITHUB_ISSUE_AUTO_PUBLISH=false

# OLLAMA_SERVER_TOKEN is the separate bridge bearer token. Keep it in Google
# Secret Manager; the relevant Functions bind it with runWith({ secrets: [...] }).
# Never put either OLLAMA_SERVER_TOKEN or the Cloudflare connector token here.
# Also store CLOUDFLARE_AI_API_TOKEN and GROQ_API_KEY in Secret Manager. The
# Workers AI API token is not the Cloudflare Tunnel connector token.
