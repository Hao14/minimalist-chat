# Firebase Functions runtime settings for the protected Ollama gateway.
# Copy to functions/.env.chat-app-356c1 before deploying production.
#
# OLLAMA_SERVER_URL must point to a protected bridge, not raw http://127.0.0.1:11434.
OLLAMA_SERVER_URL=https://your-protected-ollama-bridge.example.com
OLLAMA_MODEL=llama3.1:latest
OLLAMA_VISION_MODEL=qwen2.5vl:7b
AI_ALLOW_GROQ_FALLBACK=false

# If your bridge requires a bearer token, set this in your untracked .env file.
# For long-lived production secrets, move this to Google Secret Manager and bind
# OLLAMA_SERVER_TOKEN in the relevant runWith({ secrets: [...] }) entries.
# OLLAMA_SERVER_TOKEN=replace-with-bridge-token
