{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "searvia-web",
  "compatibility_date": "2026-07-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "searvia.online",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
