# Runtime identity (NODE_ENV is set by the process command or deployment platform)
APP_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# Authentication (local development value only; generate a unique secret in every deployment)
BETTER_AUTH_SECRET=searvia-local-development-only-auth-secret-not-for-production-2026

# Explicit, opt-in development seed. The command refuses production and requires a password.
SEARVIA_ENABLE_DEV_SEED=false
# SEARVIA_DEV_SEED_EMAIL=developer@searvia.local
# SEARVIA_DEV_SEED_PASSWORD=choose-a-development-only-password

# PostgreSQL (local development values only)
POSTGRES_DB=searvia
POSTGRES_USER=searvia
POSTGRES_PASSWORD=searvia_postgres_local_only
DATABASE_URL=postgresql://searvia:searvia_postgres_local_only@localhost:5432/searvia
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=15000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000
QUEUE_PREFIX=searvia-development
CRAWL_WORKER_CONCURRENCY=2
CRAWL_EXECUTION_LEASE_MS=300000
CRAWL_JOB_ATTEMPTS=4
CRAWL_JOB_BACKOFF_MS=1000
CRAWL_JOB_BACKOFF_JITTER=0.5
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_LEASE_MS=30000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_PUBLISH_ATTEMPTS=10
WORKER_HEALTH_INTERVAL_MS=30000
WORKER_SHUTDOWN_TIMEOUT_MS=10000

# S3-compatible object storage (MinIO for local development)
MINIO_ROOT_USER=searvia
MINIO_ROOT_PASSWORD=searvia_minio_local_only
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-west-2
OBJECT_STORAGE_BUCKET=searvia-local
OBJECT_STORAGE_ACCESS_KEY=searvia
OBJECT_STORAGE_SECRET_KEY=searvia_minio_local_only
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=10000
CRAWL_ARTIFACT_MAX_HTML_BYTES=5000000

# Optional browser rendering remains disabled unless both this deployment gate
# and a project's crawl setting are enabled. When enabling it, also set
# CRAWL_RENDER_BROWSER_EXECUTABLE to an explicit compatible Chromium path.
CRAWL_RENDERING_ENABLED=false
CRAWL_RENDER_TIMEOUT_MS=10000
CRAWL_RENDER_SETTLE_TIMEOUT_MS=1500
CRAWL_RENDER_QUIET_WINDOW_MS=250
CRAWL_RENDER_MAX_RAW_HTML_BYTES=2097152
CRAWL_RENDER_MAX_HTML_BYTES=4194304
CRAWL_RENDER_MAX_BLOCKED_REQUESTS=100
CRAWL_RENDER_BROWSER_MEMORY_MB=256
CRAWL_RENDER_CLOSE_TIMEOUT_MS=2000

# Do not place production authentication, provider, or infrastructure credentials here.
