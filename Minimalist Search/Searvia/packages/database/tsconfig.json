{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    // Drizzle publishes declarations for optional non-PostgreSQL dialect peers.
    // This skips only dependency declaration rechecking; Searvia source remains strict.
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"]
}
